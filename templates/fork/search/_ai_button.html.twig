{#
    FORK (FORK.md): the "KI-Suche" button inside the search box. It runs what
    is typed in the box as the first message of the search chat
    (templates/fork/search/_chat.html.twig) rather than as a search.

    Drawn whatever the AI switches say, because asking costs a query on every
    page (ThreadListQueryBudgetTest counts them). The search page says so when
    the chat is switched off.
#}
<button type="button"
        class="absolute right-1.5 top-1/2 -translate-y-1/2 inline-flex items-center gap-1 h-6 px-2 rounded-md
               bg-accent-soft text-accent text-[11px] font-semibold hover:bg-accent hover:text-accent-ink
               cursor-pointer transition-colors"
        title="{{ 'search.fork_chat.button_hint'|trans({}, 'fork') }}"
        data-controller="fork--ai-search"
        data-action="fork--ai-search#ask"
        data-fork--ai-search-url-value="{{ path('app_mail_search') }}"
        data-fork-ai-search>
    <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
    <span class="hidden sm:inline">{{ 'search.fork_chat.button'|trans({}, 'fork') }}</span>
</button>
